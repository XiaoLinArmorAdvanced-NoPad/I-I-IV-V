# 自动换行统一为 LF，避免跨平台 diff 噪音
* text=auto eol=lf

# Windows 脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件不做行尾转换
*.mp3 binary
*.wav binary
*.m4a binary
*.flac binary
*.ogg binary
*.aac binary
*.opus binary
*.onnx binary
*.bin binary
*.bz2 binary
*.png binary
*.jpg binary
*.gif binary

# 语言统计
*.js text
*.md text
*.json text
