{
    "name":  "asr-local",
    "version":  "1.0.0",
    "description":  "Offline audio transcription via sherpa-onnx + SenseVoice int8. No login, no API key, no network.",
    "type":  "module",
    "main":  "transcribe.js",
    "bin":  {
                "asr-local":  "transcribe.js"
            },
    "exports":  {
                    ".":  "./lib/paths.js",
                    "./wer":  "./lib/wer.js"
                },
    "files":  [
                  "transcribe.js",
                  "lib/",
                  "setup/",
                  "tests/",
                  "docs/",
                  "README.md",
                  "README.zh-CN.md",
                  "LICENSE"
              ],
    "scripts":  {
                    "setup":  "node setup/download-model.js",
                    "check":  "node transcribe.js --check",
                    "verify":  "node tests/verify-all.mjs",
                    "verify:quick":  "node tests/verify-all.mjs --quick",
                    "test":  "node tests/wer.test.js \u0026\u0026 node tests/reference.test.js \u0026\u0026 node tests/links.test.js \u0026\u0026 node tests/itn.test.js \u0026\u0026 node tests/vad.test.js \u0026\u0026 node tests/benchmark.js \u0026\u0026 node tests/e2e-test.js",
                    "test:unit":  "node tests/wer.test.js \u0026\u0026 node tests/reference.test.js \u0026\u0026 node tests/links.test.js",
                    "test:links":  "node tests/links.test.js",
                    "test:reference":  "node tests/reference.test.js",
                    "test:itn":  "node tests/itn.test.js",
                    "test:robustness":  "node tests/robustness.test.js",
                    "benchmark":  "node tests/benchmark.js",
                    "accuracy:noise":  "node tests/degradation.mjs",
                    "accuracy:dialect":  "node tests/dialect-matrix.mjs",
                    "test:vad":  "node tests/vad.test.js"
                },
    "keywords":  [
                     "asr",
                     "speech-to-text",
                     "transcription",
                     "whisper-alternative",
                     "sensevoice",
                     "sherpa-onnx",
                     "offline",
                     "onnx",
                     "listening-comprehension",
                     "u-campus"
                 ],
    "license":  "MIT",
    "engines":  {
                    "node":  "\u003e=18"
                },
    "dependencies":  {
                         "sherpa-onnx-node":  "^1.13.8"
                     },
    "optionalDependencies":  {
                                 "@ffmpeg-installer/ffmpeg":  "^1.1.0"
                             },
    "repository":  {
                       "type":  "git",
                       "url":  "https://github.com/XiaoLinArmorAdvanced-NoPad/I-I-IV-V.git"
                   },
    "bugs":  {
                 "url":  "https://github.com/XiaoLinArmorAdvanced-NoPad/I-I-IV-V/issues"
             },
    "homepage":  "https://github.com/XiaoLinArmorAdvanced-NoPad/I-I-IV-V#readme"
}
